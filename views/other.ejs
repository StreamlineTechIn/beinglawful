<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Financial - Other</title>
  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css" />
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f8f9fa;
      margin: 0;
      padding: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .navbar {
      background-color: #343a40;
      padding: 10px 20px;
    }

    .navbar-brand {
      color: white !important;
      font-size: 1.5rem;
      font-weight: bold;
    }

    .navbar-nav .nav-link {
      color: #f8f9fa !important;
      font-weight: 500;
      margin-left: 15px;
    }

    .navbar-nav .nav-link:hover {
      color: #ffffff !important;
      background-color: #495057;
      border-radius: 4px;
    }

    .dropdown-menu {
      background-color: #343a40;
      border: none;
    }

    .dropdown-item {
      color: #f8f9fa;
      font-weight: 500;
    }

    .dropdown-item:hover {
      background-color: #495057;
      color: #f8f9fa;
    }

    .content {
      flex: 1;
      padding: 20px;
      width: 100%;
      overflow-x: auto;
    }

    .counter {
      background-color: #fff;
      border: 1px solid #dee2e6;
      border-radius: 5px;
      padding: 10px;
      margin-bottom: 15px;
      font-size: 1rem;
      font-weight: 500;
    }

    .counter span {
      margin-right: 20px;
    }

    .counter .total {
      color: #343a40;
    }

    .table-container {
      width: 100%;
      height: calc(100vh - 200px);
      overflow-y: auto;
    }

    .table {
      width: 100%;
      table-layout: auto;
    }

    .table th,
    .table td {
      white-space: nowrap;
      padding: 8px;
    }

    .table th {
      position: sticky;
      top: 0;
      background-color: #343a40;
      color: white;
      z-index: 1;
    }

    .table td {
      cursor: pointer;
      transition: background-color 0.3s;
    }

    .table td:hover {
      background-color: #e9ecef;
    }

    .btn-primary {
      background-color: #0069d9;
      border: none;
      padding: 5px 10px;
      font-size: 0.875rem;
    }

    .btn-primary:hover {
      background-color: #0056b3;
    }

    .btn-danger {
      padding: 5px 10px;
      font-size: 0.875rem;
    }

    .selected-text {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background-color: #343a40;
      color: white;
      padding: 10px 20px;
      border-radius: 5px;
      display: none;
      z-index: 1000;
    }

    .modal-content {
      border-radius: 8px;
    }

    .modal-header {
      background-color: #343a40;
      color: white;
    }

    .modal-footer {
      border-top: none;
    }

    @media (max-width: 768px) {
      .content {
        padding: 10px;
      }

      .counter {
        font-size: 0.875rem;
        padding: 8px;
      }

      .counter span {
        display: block;
        margin-bottom: 5px;
      }

      .table-container {
        height: calc(100vh - 180px);
      }

      .form-inline .form-control {
        width: 100%;
      }

      .form-inline .btn {
        width: 100%;
      }

      .selected-text {
        width: calc(100% - 40px);
        bottom: 10px;
        right: 10px;
        font-size: 0.875rem;
      }

      .navbar-nav .nav-link {
        margin-left: 0;
        padding: 10px;
      }
    }
  </style>
</head>
<body>
  <!-- Navbar with Menubar -->
  <nav class="navbar navbar-expand">
    <a class="navbar-brand" href="#">Logistic Portal</a>
    <div class="navbar-nav">
      <a class="nav-link" href="/logistic-dashboard">Dashboard</a>
      <div class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" id="financialDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
          Financial
        </a>
        <div class="dropdown-menu" aria-labelledby="financialDropdown">
          <a class="dropdown-item" href="/other">Other</a>
          <a class="dropdown-item" href="/financial">Financial</a>
        </div>
      </div>
    </div>
    <div class="ml-auto">
      <div class="dropdown">
        <button class="btn btn-dark dropdown-toggle" type="button" id="menuDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
          <span class="navbar-toggler-icon">⋮</span>
        </button>
        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="menuDropdown">
          <a class="dropdown-item" href="/logistic-dashboard">Dashboard</a>
          <a class="dropdown-item" href="/logout">Logout</a>
        </div>
      </div>
    </div>
  </nav>

  <div class="content">
    <h3 class="mb-3">Financial Entries</h3>

    <!-- Add Financial Entry Button -->
    <div class="mb-3">
      <button class="btn btn-primary" data-toggle="modal" data-target="#addFinancialModal">Add Financial Entry</button>
    </div>

    <!-- Counter Display -->
    <div class="counter">
      <span class="total">Total Entries: <span id="totalCount">0</span></span>
    </div>

    <!-- Selected Text Notification -->
    <div class="selected-text" id="selectedText"></div>

    <!-- Table Container -->
    <div class="table-container">
      <table class="table table-bordered table-striped">
        <thead class="thead-dark">
          <tr>
            <th>Name</th>
            <th>Amount</th>
            <th>Description</th>
            <th>Created At</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody id="financialTableBody">
          <!-- Financial entries will be populated here -->
        </tbody>
      </table>
    </div>
  </div>

  <!-- Add Financial Entry Modal -->
  <div class="modal fade" id="addFinancialModal" tabindex="-1" role="dialog" aria-labelledby="addFinancialModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addFinancialModalLabel">Add Financial Entry</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <form id="addFinancialForm">
          <div class="modal-body">
            <div class="form-group">
              <label for="financialName">Name</label>
              <input type="text" class="form-control" id="financialName" name="name" required placeholder="Enter name">
            </div>
            <div class="form-group">
              <label for="financialAmount">Amount</label>
              <input type="number" class="form-control" id="financialAmount" name="amount" required placeholder="Enter amount" min="0" step="0.01">
            </div>
            <div class="form-group">
              <label for="financialDescription">Description</label>
              <textarea class="form-control" id="financialDescription" name="description" rows="4" placeholder="Enter description"></textarea>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            <button type="submit" class="btn btn-primary">Submit</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Edit Financial Entry Modal -->
  <div class="modal fade" id="editFinancialModal" tabindex="-1" role="dialog" aria-labelledby="editFinancialModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="editFinancialModalLabel">Edit Financial Entry</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <form id="editFinancialForm">
          <div class="modal-body">
            <input type="hidden" id="editFinancialId" name="id">
            <div class="form-group">
              <label for="editFinancialName">Name</label>
              <input type="text" class="form-control" id="editFinancialName" name="name" required placeholder="Enter name">
            </div>
            <div class="form-group">
              <label for="editFinancialAmount">Amount</label>
              <input type="number" class="form-control" id="editFinancialAmount" name="amount" required placeholder="Enter amount" min="0" step="0.01">
            </div>
            <div class="form-group">
              <label for="editFinancialDescription">Description</label>
              <textarea class="form-control" id="editFinancialDescription" name="description" rows="4" placeholder="Enter description"></textarea>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            <button type="submit" class="btn btn-primary">Update</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS and dependencies -->
  <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.12.9/umd/popper.min.js"></script>
  <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/js/bootstrap.min.js"></script>

  <!-- Firebase SDK -->
  <script type="module">
    // Import Firebase SDK modules
    import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.14.0/firebase-app.js';
    import { getFirestore, collection, addDoc, onSnapshot, query, orderBy, serverTimestamp, deleteDoc, doc, updateDoc } from 'https://www.gstatic.com/firebasejs/10.14.0/firebase-firestore.js';

    // Firebase configuration
    const firebaseConfig = {
      apiKey: "YOUR_API_KEY", // Replace with your Firebase project's apiKey
      authDomain: "beinglawful-ee5a4.firebaseapp.com",
      projectId: "beinglawful-ee5a4",
      storageBucket: "beinglawful-ee5a4.firebasestorage.app",
      messagingSenderId: "YOUR_MESSAGING_SENDER_ID", // Replace with your Firebase project's messagingSenderId
      appId: "YOUR_APP_ID" // Replace with your Firebase project's appId
    };

    // Initialize Firebase
    const app = initializeApp(firebaseConfig);
    const db = getFirestore(app);

    // Function to update counter display
    function updateCounter() {
      const totalCount = document.querySelectorAll('#financialTableBody tr').length;
      document.getElementById('totalCount').textContent = totalCount;
    }

    // Function to populate the financial table
    function populateTable() {
      const tableBody = document.getElementById('financialTableBody');
      tableBody.innerHTML = ''; // Clear existing rows

      const q = query(collection(db, 'financials'), orderBy('createdAt', 'desc'));
      onSnapshot(q, (snapshot) => {
        tableBody.innerHTML = ''; // Clear table on update
        if (snapshot.empty) {
          tableBody.innerHTML = '<tr><td colspan="5">No financial entries found.</td></tr>';
        } else {
          snapshot.forEach(doc => {
            const data = doc.data();
            const row = document.createElement('tr');
            row.innerHTML = `
              <td>${data.name || 'N/A'}</td>
              <td>${data.amount ? data.amount.toFixed(2) : 'N/A'}</td>
              <td>${data.description || 'N/A'}</td>
              <td>${data.createdAt ? data.createdAt.toDate().toLocaleDateString('en-IN') : 'N/A'}</td>
              <td>
                <button class="btn btn-primary btn-sm edit-btn" data-id="${doc.id}" data-name="${data.name || ''}" data-amount="${data.amount || ''}" data-description="${data.description || ''}" data-toggle="modal" data-target="#editFinancialModal">Edit</button>
                <button class="btn btn-danger btn-sm delete-btn" data-id="${doc.id}">Delete</button>
              </td>
            `;
            tableBody.appendChild(row);
          });
        }
        updateCounter();
      }, (error) => {
        console.error('Error fetching financial data:', error);
        tableBody.innerHTML = '<tr><td colspan="5">Error loading data.</td></tr>';
      });
    }

    // Handle add form submission
    document.getElementById('addFinancialForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const name = document.getElementById('financialName').value;
      const amount = parseFloat(document.getElementById('financialAmount').value);
      const description = document.getElementById('financialDescription').value;

      try {
        await addDoc(collection(db, 'financials'), {
          name,
          amount,
          description,
          createdAt: serverTimestamp()
        });
        $('#addFinancialModal').modal('hide');
        document.getElementById('addFinancialForm').reset();
        const selectedTextDiv = document.getElementById('selectedText');
        selectedTextDiv.textContent = 'Financial entry added successfully!';
        selectedTextDiv.style.display = 'block';
        setTimeout(() => {
          selectedTextDiv.style.display = 'none';
        }, 3000);
      } catch (error) {
        console.error('Error adding financial entry:', error);
        alert('Failed to add financial entry.');
      }
    });

    // Handle edit form submission
    document.getElementById('editFinancialForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const id = document.getElementById('editFinancialId').value;
      const name = document.getElementById('editFinancialName').value;
      const amount = parseFloat(document.getElementById('editFinancialAmount').value);
      const description = document.getElementById('editFinancialDescription').value;

      try {
        await updateDoc(doc(db, 'financials', id), {
          name,
          amount,
          description,
          createdAt: serverTimestamp()
        });
        $('#editFinancialModal').modal('hide');
        document.getElementById('editFinancialForm').reset();
        const selectedTextDiv = document.getElementById('selectedText');
        selectedTextDiv.textContent = 'Financial entry updated successfully!';
        selectedTextDiv.style.display = 'block';
        setTimeout(() => {
          selectedTextDiv.style.display = 'none';
        }, 3000);
      } catch (error) {
        console.error('Error updating financial entry:', error);
        alert('Failed to update financial entry.');
      }
    });

    // Handle table cell click to show text (excluding action column)
    document.querySelectorAll('.table td:not(:last-child)').forEach(cell => {
      cell.addEventListener('click', function () {
        const text = this.textContent.trim();
        if (text) {
          const selectedTextDiv = document.getElementById('selectedText');
          selectedTextDiv.textContent = `Selected: ${text}`;
          selectedTextDiv.style.display = 'block';
          setTimeout(() => {
            selectedTextDiv.style.display = 'none';
          }, 3000);
          this.style.backgroundColor = '#d1ecf1';
          setTimeout(() => {
            this.style.backgroundColor = '';
          }, 1000);
        }
      });
    });

    // Handle edit and delete button clicks
    document.getElementById('financialTableBody').addEventListener('click', async (e) => {
      if (e.target.classList.contains('edit-btn')) {
        const id = e.target.getAttribute('data-id');
        const name = e.target.getAttribute('data-name');
        const amount = e.target.getAttribute('data-amount');
        const description = e.target.getAttribute('data-description');

        document.getElementById('editFinancialId').value = id;
        document.getElementById('editFinancialName').value = name;
        document.getElementById('editFinancialAmount').value = amount;
        document.getElementById('editFinancialDescription').value = description;
      } else if (e.target.classList.contains('delete-btn')) {
        const id = e.target.getAttribute('data-id');
        if (confirm('Are you sure you want to delete this financial entry?')) {
          try {
            await deleteDoc(doc(db, 'financials', id));
            const selectedTextDiv = document.getElementById('selectedText');
            selectedTextDiv.textContent = 'Financial entry deleted successfully!';
            selectedTextDiv.style.display = 'block';
            setTimeout(() => {
              selectedTextDiv.style.display = 'none';
            }, 3000);
          } catch (error) {
            console.error('Error deleting financial entry:', error);
            alert('Failed to delete financial entry.');
          }
        }
      }
    });

    // Initialize table on page load
    populateTable();
  </script>
</body>
</html>